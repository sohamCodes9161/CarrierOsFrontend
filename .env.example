# Base URL of the CareerOS backend API (including the /api/v1 prefix).
VITE_API_BASE_URL=http://localhost:5000/api/v1

# The backend registers PATCH /portfolio/{section}/reorder AFTER PATCH /portfolio/{section}/:itemId,
# so Express matches "reorder" as an :itemId and the reorder endpoints return 404.
# Once the backend routes are reordered, set this to "true" to show the up/down reorder buttons.
VITE_ENABLE_REORDER=false
